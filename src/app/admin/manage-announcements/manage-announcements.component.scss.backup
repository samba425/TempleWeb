.manage-announcements {
  position: relative;
  padding: 1.5rem;
  max-width: 1400px;
  margin: 0 auto;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
  min-height: 100vh;
}

.content-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  padding: 1.5rem 2rem;
  background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  border: 1px solid rgba(212, 101, 26, 0.1);

  h1 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: #1a1a1a;
    background: linear-gradient(135deg, #d4651a, #c43b00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;

    mat-icon {
      color: #d4651a;
      font-size: 2rem;
      width: 2rem;
      height: 2rem;
      -webkit-text-fill-color: #d4651a;
    }
  }

  .subtitle {
    margin: 0.5rem 0 0 3rem;
    color: #6b7280;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .header-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  button {
    mat-icon {
      margin-right: 0.5rem;
    }
  }
}

.announcements-container {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.announcement-card {
  background: white;
  border-radius: 12px;
  padding: 0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border-left: 4px solid #d4651a;

  &:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    background: linear-gradient(135deg, #faf9f8 0%, #ffffff 100%);
    border-bottom: 1px solid #e5e7eb;

    .header-left {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex: 1;

      h3 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-size: 1.2rem;
        font-weight: 600;
        color: #1f2937;

        mat-icon {
          color: #d4651a;
        }
      }

      .status-badge {
        padding: 0.35rem 0.85rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
        color: #4f46e5;
      }
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
  }

  .card-content {
    padding: 2rem;
  }
}

.image-upload-section {
  margin-bottom: 1.5rem;

  .upload-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #374151;
    margin-bottom: 0.75rem;

    mat-icon {
      color: #d4651a;
      font-size: 1.2rem;
      width: 1.2rem;
      height: 1.2rem;
    }
  }

  .upload-container {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 2px dashed #d1d5db;
    border-radius: 8px;
    background: #f9fafb;
    transition: all 0.3s ease;

    &:hover {
      border-color: #d4651a;
      background: #fef9f5;
    }

    button {
      flex-shrink: 0;
    }
  }

  .image-preview {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;

    img {
      width: 80px;
      height: 80px;
      object-fit: cover;
      border-radius: 8px;
      border: 2px solid #d4651a;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    button {
      position: absolute;
      top: -8px;
      right: -8px;
      width: 24px;
      height: 24px;
      min-width: unset;
      padding: 0;
      background: white;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);

      mat-icon {
        font-size: 16px;
        width: 16px;
        height: 16px;
      }
    }
  }

  .upload-hint {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: #6b7280;
  }
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-bottom: 1rem;
}

.full-width {
  width: 100%;
  margin-bottom: 1rem;
}

.priority-select {
  width: 100%;
}

.empty-state {
  text-align: center;
  padding: 5rem 2rem;
  background: white;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);

  mat-icon {
    font-size: 5rem;
    width: 5rem;
    height: 5rem;
    color: #d4651a;
    margin-bottom: 1.5rem;
    opacity: 0.7;
  }

  h2 {
    margin: 0 0 0.5rem 0;
    font-size: 1.75rem;
    font-weight: 600;
    color: #1f2937;
  }

  p {
    margin: 0 0 2rem 0;
    font-size: 1.1rem;
    color: #6b7280;
  }

  button {
    mat-icon {
      margin-right: 0.5rem;
    }
  }
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;

  p {
    margin-top: 1.5rem;
    color: white;
    font-size: 1.1rem;
    font-weight: 500;
  }
}

@media (max-width: 768px) {
  .manage-announcements {
    padding: 1rem;
  }

  .content-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.25rem;

    h1 {
      font-size: 1.4rem;
    }

    .subtitle {
      margin-left: 2.5rem;
      font-size: 0.85rem;
    }

    .header-actions {
      width: 100%;
      flex-direction: column;

      button {
        width: 100%;
      }
    }
  }

  .announcement-card {
    .card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.25rem;

      .header-left {
        flex-wrap: wrap;
      }

      .header-right {
        width: 100%;
        justify-content: space-between;
      }
    }

    .card-content {
      padding: 1.25rem;
    }
  }

  .grid-2 {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .empty-state {
    padding: 3rem 1.5rem;

    mat-icon {
      font-size: 4rem;
      width: 4rem;
      height: 4rem;
    }

    h2 {
      font-size: 1.4rem;
    }

    p {
      font-size: 0.95rem;
    }
  }
}
