.manage-content {
  position: relative;
  padding: 1.5rem;
  max-width: 1600px;
  margin: 0 auto;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
  min-height: 100vh;
}

.content-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  padding: 1.5rem 2rem;
  background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  border: 1px solid rgba(212, 101, 26, 0.1);

  h1 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: #1a1a1a;
    background: linear-gradient(135deg, #d4651a, #c43b00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;

    mat-icon {
      color: #d4651a;
      font-size: 2rem;
      width: 2rem;
      height: 2rem;
      -webkit-text-fill-color: #d4651a;
    }
  }

  .subtitle {
    margin: 0.5rem 0 0 3rem;
    color: #6b7280;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .save-btn {
    height: 52px;
    padding: 0 2rem;
    font-size: 1.05rem;
    font-weight: 600;
    background: linear-gradient(135deg, #d4651a, #c43b00) !important;
    border-radius: 10px;
    box-shadow: 0 4px 12px rgba(212, 101, 26, 0.3);
    transition: all 0.3s ease;

    mat-icon {
      margin-right: 0.5rem;
    }

    &:not([disabled]):hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(212, 101, 26, 0.5);
    }

    &:not([disabled]):active {
      transform: translateY(0);
    }

    &[disabled] {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }
}

.content-tabs {
  background: white;
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  overflow: hidden;

  ::ng-deep {
    .mat-mdc-tab-header {
      background: linear-gradient(to bottom, #ffffff, #fafbfc);
      border-bottom: 2px solid #f0f0f0;
    }

    .mat-mdc-tab-labels {
      padding: 0.5rem 1rem;
    }

    .mat-mdc-tab {
      min-width: 140px;
      padding: 0 1.5rem;
      font-weight: 500;
      
      mat-icon {
        margin-right: 0.5rem;
        font-size: 1.3rem;
        width: 1.3rem;
        height: 1.3rem;
      }

      .mdc-tab__text-label {
        font-size: 0.95rem;
        letter-spacing: 0.3px;
      }

      &:hover:not(.mat-mdc-tab-disabled) {
        background: rgba(212, 101, 26, 0.05);
      }
    }

    .mat-mdc-tab.mat-mdc-tab-active {
      background: rgba(212, 101, 26, 0.08);
      
      .mdc-tab__text-label {
        color: #d4651a;
        font-weight: 600;
      }

      mat-icon {
        color: #d4651a;
      }
    }

    .mat-ink-bar {
      background-color: #d4651a !important;
      height: 3px !important;
    }

    .mat-mdc-tab-body-content {
      padding: 2rem;
    }
  }
}

.tab-content {
  mat-card {
    margin-bottom: 1.5rem;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;

    &:hover {
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
      transform: translateY(-2px);
    }

    h2 {
      margin: 0 0 2rem 0;
      padding-bottom: 1rem;
      color: #1a1a1a;
      font-size: 1.4rem;
      font-weight: 700;
      border-bottom: 2px solid #f0f0f0;
      display: flex;
      align-items: center;
      
      &::before {
        content: '';
        width: 4px;
        height: 28px;
        background: linear-gradient(135deg, #d4651a, #c43b00);
        margin-right: 1rem;
        border-radius: 2px;
      }
    }

    h3 {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 2rem 0 1.5rem 0;
      padding: 1rem 1.5rem;
      background: linear-gradient(135deg, rgba(212, 101, 26, 0.1), rgba(196, 59, 0, 0.08));
      border-radius: 10px;
      color: #d4651a;
      font-size: 1.2rem;
      font-weight: 700;
      border-left: 5px solid #d4651a;
      box-shadow: 0 2px 8px rgba(212, 101, 26, 0.15);
      position: relative;
      overflow: hidden;

      &::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, #d4651a, #c43b00, transparent);
      }

      &::after {
        content: '';
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(180deg, #d4651a, #c43b00);
        border-radius: 0 10px 10px 0;
      }

      button {
        background: white !important;
        box-shadow: 0 3px 10px rgba(212, 101, 26, 0.25);
        width: 40px;
        height: 40px;
        border-radius: 10px;
        transition: all 0.3s ease;
        
        mat-icon {
          color: #d4651a;
          font-size: 1.4rem;
          font-weight: bold;
        }

        &:hover {
          background: #d4651a !important;
          transform: scale(1.1) rotate(90deg);
          box-shadow: 0 5px 16px rgba(212, 101, 26, 0.4);
          
          mat-icon {
            color: white;
          }
        }
      }
    }
  }

  ::ng-deep {
    .mat-mdc-form-field {
      margin-bottom: 1.5rem;
      width: 100%;

      .mat-mdc-text-field-wrapper {
        background: white;
        border-radius: 10px;
        border: 2px solid #e5e7eb;
        transition: all 0.3s ease;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
        padding: 0 !important;

        &:hover {
          border-color: rgba(212, 101, 26, 0.4);
          background: #fafbfc;
          box-shadow: 0 2px 8px rgba(212, 101, 26, 0.08);
        }
      }

      .mat-mdc-form-field-flex {
        padding: 0 !important;
        align-items: flex-start !important;
      }

      .mat-mdc-form-field-infix {
        padding: 24px 16px 8px 16px !important;
        border-top: none !important;
        min-height: 56px;
        width: 100%;
      }

      .mdc-notched-outline {
        display: none !important;
      }

      &.mat-focused {
        .mat-mdc-text-field-wrapper {
          background: white;
          border-color: #d4651a;
          border-width: 2px;
          box-shadow: 0 0 0 4px rgba(212, 101, 26, 0.12);
        }

        .mat-mdc-floating-label {
          color: #d4651a !important;
          font-weight: 600;
        }
      }

      .mat-mdc-floating-label {
        font-weight: 500;
        color: #6b7280;
        font-size: 0.875rem;
        position: absolute !important;
        left: 16px !important;
        top: 8px !important;
        transform: none !important;
        transition: all 0.2s ease;

        &.mdc-floating-label--float-above {
          font-size: 0.75rem !important;
          top: 8px !important;
          transform: none !important;
        }
      }

      &:not(.mat-form-field-should-float) .mat-mdc-floating-label {
        top: 20px !important;
        font-size: 0.9rem !important;
      }

      .mat-mdc-input-element {
        padding: 0 !important;
        font-size: 0.95rem;
        color: #1a1a1a;
        height: auto;
        line-height: 1.5;
        background: transparent;

        &::placeholder {
          color: #9ca3af;
          opacity: 0;
        }
      }

      textarea.mat-mdc-input-element {
        line-height: 1.6;
        min-height: 100px !important;
        resize: vertical;
        margin: 0 !important;
        padding: 0 !important;
      }

      // Hide the underline
      .mat-mdc-form-field-focus-overlay {
        display: none !important;
      }

      .mat-mdc-form-field-subscript-wrapper {
        margin-top: 0.25rem;
        padding: 0 16px;
      }

      .mat-mdc-form-field-bottom-align {
        &::before {
          display: none !important;
        }
      }

      // Error state
      &.mat-form-field-invalid {
        .mat-mdc-text-field-wrapper {
          border-color: #dc2626;
        }
      }
    }

    .mat-mdc-raised-button {
      border-radius: 10px;
      font-weight: 600;
      padding: 0.75rem 1.5rem;
      transition: all 0.3s ease;
      text-transform: none;
      letter-spacing: 0.3px;

      &.mat-primary {
        background: linear-gradient(135deg, #d4651a, #c43b00);
        box-shadow: 0 3px 10px rgba(212, 101, 26, 0.3);

        &:hover {
          box-shadow: 0 5px 16px rgba(212, 101, 26, 0.45);
          transform: translateY(-2px);
        }

        &:active {
          transform: translateY(0);
        }
      }
    }

    .mat-mdc-icon-button {
      border-radius: 8px;
      transition: all 0.3s ease;

      &:hover {
        background: rgba(212, 101, 26, 0.08);
      }
    }
  }
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  padding: 1.25rem 1.5rem;
  background: linear-gradient(135deg, #fff5f0, #ffe8dc);
  border-radius: 10px;
  border: 2px solid rgba(212, 101, 26, 0.2);
  box-shadow: 0 2px 8px rgba(212, 101, 26, 0.1);

  h4 {
    margin: 0;
    color: #d4651a;
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    
    &::before {
      content: '•';
      margin-right: 0.75rem;
      font-size: 1.5rem;
      color: #d4651a;
    }
  }

  button {
    transition: all 0.3s ease;
    background: white !important;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(212, 101, 26, 0.2);
    
    mat-icon {
      color: #dc2626;
      font-size: 1.3rem;
      transition: all 0.3s ease;
    }
    
    &:hover {
      transform: scale(1.1);
      box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
      
      mat-icon {
        transform: rotate(90deg);
      }
    }
  }
}

.nested-card {
  background: linear-gradient(135deg, #ffffff, #fafbfc) !important;
  margin-bottom: 2rem !important;
  border-left: 5px solid #d4651a !important;
  border-radius: 12px !important;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08) !important;
  transition: all 0.3s ease;
  padding: 1.5rem !important;
  position: relative;
  overflow: hidden;

  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #d4651a, #c43b00, transparent);
  }

  &:hover {
    border-left-width: 7px !important;
    box-shadow: 0 6px 20px rgba(212, 101, 26, 0.2) !important;
    transform: translateX(4px);
  }

  ::ng-deep {
    .mat-mdc-form-field {
      width: 100%;
      margin-bottom: 1rem;
      
      .mat-mdc-text-field-wrapper {
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        padding: 0 !important;
        transition: all 0.3s ease;

        &:hover {
          border-color: rgba(212, 101, 26, 0.3);
          background: #fafbfc;
        }
      }

      .mat-mdc-form-field-flex {
        padding: 0 !important;
        align-items: flex-start !important;
      }

      .mat-mdc-form-field-infix {
        padding: 24px 16px 8px 16px !important;
        border-top: none !important;
        min-height: 56px;
        width: 100%;
      }

      .mdc-notched-outline {
        display: none !important;
      }

      .mat-mdc-floating-label {
        position: absolute !important;
        left: 16px !important;
        top: 8px !important;
        font-size: 0.875rem;
        color: #6b7280;
        font-weight: 500;
        transform: none !important;
        transition: all 0.2s ease;

        &.mdc-floating-label--float-above {
          font-size: 0.75rem !important;
          top: 8px !important;
          transform: none !important;
        }
      }

      &:not(.mat-form-field-should-float) .mat-mdc-floating-label {
        top: 20px !important;
        font-size: 0.9rem !important;
      }

      &.mat-focused {
        .mat-mdc-text-field-wrapper {
          background: white;
          border-color: #d4651a;
          box-shadow: 0 0 0 3px rgba(212, 101, 26, 0.1);
        }

        .mat-mdc-floating-label {
          color: #d4651a !important;
          font-weight: 600;
        }
      }

      .mat-mdc-input-element {
        padding: 0 !important;
        line-height: 1.5;
        font-size: 0.95rem;
        color: #1a1a1a;
        background: transparent;
      }

      .mat-mdc-form-field-focus-overlay {
        display: none !important;
      }

      .mat-mdc-form-field-bottom-align::before {
        display: none !important;
      }

      .mat-mdc-form-field-subscript-wrapper {
        padding: 0 16px;
        margin-top: 0.25rem;
      }
    }

    textarea.mat-mdc-input-element {
      min-height: 100px !important;
      line-height: 1.6;
      resize: vertical;
      padding: 0 !important;
      margin: 0 !important;
    }
  }
}

.array-section {
  margin-top: 2.5rem;
  padding: 2rem;
  background: linear-gradient(135deg, #fef5f0, #fef9f5);
  border-radius: 12px;
  border: 2px solid rgba(212, 101, 26, 0.15);
  box-shadow: inset 0 2px 8px rgba(212, 101, 26, 0.05);
  position: relative;

  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #d4651a, #c43b00);
    border-radius: 12px 12px 0 0;
  }
}

.array-item {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
  margin-bottom: 1.25rem;
  padding: 1rem;
  background: white;
  border-radius: 10px;
  border: 1px solid #e5e7eb;
  transition: all 0.3s ease;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);

  &:hover {
    background: #fafbfc;
    border-color: rgba(212, 101, 26, 0.3);
    box-shadow: 0 3px 12px rgba(212, 101, 26, 0.12);
    transform: translateY(-2px);
  }

  button {
    margin-top: 0.5rem;
    background: white !important;
    box-shadow: 0 2px 6px rgba(220, 38, 38, 0.2);
    transition: all 0.3s ease;

    mat-icon {
      color: #dc2626;
    }

    &:hover {
      background: #dc2626 !important;
      transform: scale(1.1);
      box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4);

      mat-icon {
        color: white;
      }
    }
  }
}

.full-width {
  width: 100%;
}

.flex-1 {
  flex: 1;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  margin-bottom: 1rem;

  @media (max-width: 768px) {
    grid-template-columns: 1fr;
  }
}

// Add visual separator for form sections
.form-section-divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(212, 101, 26, 0.3), transparent);
  margin: 2rem 0;
}

.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(10px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  z-index: 1000;
  border-radius: 16px;

  mat-spinner {
    ::ng-deep circle {
      stroke: #d4651a !important;
    }
  }

  p {
    color: #374151;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.3px;
  }
}

.empty-state {
  text-align: center;
  padding: 3rem 2rem;
  color: #9ca3af;
  
  mat-icon {
    font-size: 4rem;
    width: 4rem;
    height: 4rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }
  
  p {
    font-size: 1.1rem;
  }
}

@media (max-width: 768px) {
  .manage-content {
    padding: 1rem;
  }

  .content-header {
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    padding: 1.25rem;

    h1 {
      font-size: 1.5rem;
    }

    .subtitle {
      margin-left: 0;
    }

    .save-btn {
      width: 100%;
    }
  }

  .grid-2 {
    grid-template-columns: 1fr;
  }

  .content-tabs ::ng-deep {
    .mat-mdc-tab {
      min-width: 100px;
      padding: 0 0.75rem;
      
      .mdc-tab__text-label {
        font-size: 0.85rem;
      }
    }

    .mat-mdc-tab-body-content {
      padding: 1rem;
    }
  }
}
