rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to siteContent (temple content, announcements, etc.)
    match /siteContent/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to content and gallery for everyone
    match /content/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Announcements - public read, authenticated write
    match /announcements/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Donations - allow create for everyone, read/update only for authenticated users
    match /donations/{document=**} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }
  }
}
